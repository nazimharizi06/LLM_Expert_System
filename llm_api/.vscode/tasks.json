{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Main API",
      "type": "shell",
      "command": "uvicorn baseline_model.api_model:app --host 127.0.0.1 --port 8888",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Angular API",
      "type": "shell",
      "command": "uvicorn angular_model.api_angle_model:app --host 127.0.0.1 --port 8890",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Cloudflare Tunnel",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "while ($true) { .\\cloudflared.exe tunnel --protocol http2 --config .\\config.yml run llm_api; Start-Sleep -Seconds 1 }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start All APIs + Tunnel",
      "dependsOn": [
        "Run Main API",
        "Run Angular API",
        "Run Cloudflare Tunnel"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
